# Frontend (Vite) — copy to .env.local and fill in.
# Run `npx convex dev` once to get your deployment URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk publishable key (Dashboard → API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend (Convex) — set on the Convex deployment, NOT in .env.local:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
#
# Optional OpenRouter model override (defaults to openai/gpt-4o-mini):
#   npx convex env set OPENROUTER_MODEL openai/gpt-4o-mini
#
# AI keys are NOT set on the deployment. Each user adds their own
# OpenRouter (and optional OpenAI) key in Settings (BYOK).
